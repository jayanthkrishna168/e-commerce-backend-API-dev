{
  "name": "ecommerce-weather-backend-",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "start": "node app.js",
    "dev": "nodemon app.js",
    "test": "jest --detectOpenHandles --runInBand --testTimeout=15000",
    "test:watch": "jest --watchAll --detectOpenHandles --runInBand --testTimeout=15000",
    "test:ci": "jest --coverage --detectOpenHandles --runInBand --testTimeout=15000",
    "test:unit": "jest --detectOpenHandles --runInBand -t \"Unit Tests\" --testTimeout=15000",
    "test:integration": "jest --detectOpenHandles --runInBand -t \"Integration Tests\" --testTimeout=15000",
    "lint": "eslint .",
    "swagger": "node ./swagger.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jayanthkrishnakalavapudi/ecommerce-weather-backend-.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/jayanthkrishnakalavapudi/ecommerce-weather-backend-/issues"
  },
  "homepage": "https://github.com/jayanthkrishnakalavapudi/ecommerce-weather-backend-#readme",
  "dependencies": {
    "axios": "^1.8.4",
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.13.2",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "eslint": "^9.24.0",
    "express-winston": "^4.2.0",
    "jest": "^29.7.0",
    "mongoose-mock": "^0.4.0",
    "nodemon": "^3.1.9",
    "supertest": "^7.1.0",
    "winston": "^3.17.0"
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "**/*.js",
      "!**/node_modules/**",
      "!**/swagger.js",
      "!**/app.js",
      "!**/test.js"
    ],
    "coveragePathIgnorePatterns": [
      "/node_modules/",
      "/logs/"
    ]
  }
}